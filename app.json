{
  "expo": {
    "name": "Caller Man",
    "slug": "caller-man",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.callerman.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "ACCESS_NOTIFICATION_POLICY",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "USE_FULL_SCREEN_INTENT",
        "VIBRATE",
        "WAKE_LOCK"
      ]
    },
    "plugins": [
      "expo-location",
      "expo-task-manager",
      "@rnmapbox/maps",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-asset",
      "expo-font",
      "./plugins/withAlarmActivity"
    ],
    "extra": {
      "eas": {
        "projectId": "c90c40e9-a62a-43a0-a829-136a84b05a0f"
      }
    },
    "owner": "ie.santhosh.m"
  }
}
